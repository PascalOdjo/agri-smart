{
    "name": "agri-smart-backend",
    "version": "1.0.0",
    "description": "AgriSmart Togo backend API - Express.js + MySQL",
    "type": "module",
    "main": "src/server.js",
    "scripts": {
        "dev": "node --watch src/server.js",
        "start": "node src/server.js",
        "lint": "eslint src --fix"
    },
    "dependencies": {
        "express": "^4.18.2",
        "mysql2": "^3.6.5",
        "sequelize": "^6.35.2",
        "dotenv": "^16.3.1",
        "bcryptjs": "^2.4.3",
        "jsonwebtoken": "^8.5.1",
        "multer": "^1.4.5-lts.1",
        "cors": "^2.8.5",
        "helmet": "^7.1.0",
        "express-validator": "^7.0.0",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "eslint": "^8.54.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.0.1",
        "prettier": "^3.1.1"
    },
    "eslintConfig": {
        "env": {
            "node": true,
            "es2021": true
        },
        "extends": [
            "eslint:recommended",
            "prettier"
        ],
        "parserOptions": {
            "ecmaVersion": 12,
            "sourceType": "module"
        },
        "rules": {
            "no-unused-vars": ["warn", { "argsIgnorePattern": "^next$" }]
        }
    }
}
